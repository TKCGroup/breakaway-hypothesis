{
  "name": "@tkc/geospace-watcher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:once": "tsx src/worker.ts",
    "start": "node dist/server.js",
    "start:once": "node dist/worker.js",
    "start:loop": "node dist/worker.js --loop",
    "migrate": "tsx src/db/migrate.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/node": "^24.0.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
